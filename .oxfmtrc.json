{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "arrowParens": "always",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "ignorePatterns": [
    "**/node_modules/**",
    "dist/**",
    "build/**",
    "apps/desktop/dist/**",
    "apps/client/vendor/**",
    "apps/client/resources/**",
    "apps/client/original_resources/**",
    "packages/data/packages.js",
    "apps/client/tools/FileSaver.min.ts",
    "apps/client/tools/dat.gui.ts",
    "packages/*/dist/**",
    "packages/Backbone.VirtualCollection/**",
    "scripts/codex/**",
    "apps/server/migrations/**",
    "**/*.hbs",
    "**/*.html",
    "**/*.scss",
    "**/*.css",
    "**/*.vert",
    "**/*.frag",
    "**/*.glsl"
  ]
}
