{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "arrowParens": "always",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "ignorePatterns": [
    "**/node_modules/**",
    "dist/**",
    "desktop/dist/**",
    "app/vendor/**",
    "app/resources/**",
    "app/original_resources/**",
    "app/data/packages.js",
    "app/tools/FileSaver.min.ts",
    "app/tools/dat.gui.ts",
    "packages/**",
    "scripts/codex/**",
    "server/migrations/**",
    "**/*.hbs",
    "**/*.html",
    "**/*.scss",
    "**/*.css",
    "**/*.vert",
    "**/*.frag",
    "**/*.glsl"
  ]
}
