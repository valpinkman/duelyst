{
  // Shared oxlint base. Every workspace package extends this file rather than
  // redeclaring rules, so "what lint means" is defined in exactly one place.
  //
  // Replaces an 876-line .eslintrc.json that was mostly per-directory DOWNGRADES:
  // airbnb-base turned on hundreds of stylistic rules this 2016 codebase cannot
  // satisfy, and 18 override blocks turned them back off again. oxlint's
  // `correctness` category is the part that was actually earning its keep -- it
  // found two real bugs on its first run (an always-false `!x instanceof Y`
  // guard, and a quest goal returning a boolean through a dead object literal).
  //
  // Formatting is NOT lint's job here: oxfmt owns it.
  "$schema": "../../node_modules/oxlint/configuration_schema.json",

  "plugins": ["typescript", "oxc", "import"],

  "categories": {
    // the bug-finding category, and the reason for the swap
    "correctness": "error",
  },

  "env": {
    "builtin": true,
    "browser": true,
    "node": true,
    "es2024": true,
  },

  "globals": {
    // vendor libraries concatenated into dist/src/vendor.js and used as globals
    // (see scripts/build/build-client.mjs VENDOR_FILES and app/types/globals.d.ts)
    "cc": "readonly",
    "gl": "readonly",
    "$": "readonly",
    "jQuery": "readonly",
    "Backbone": "readonly",
    "Marionette": "readonly",
    "Handlebars": "readonly",
    "Velocity": "readonly",
    "AWS": "readonly",
    "ga": "readonly",
  },

  "rules": {
    // --- deliberately off, with reasons -------------------------------------
    //
    // These are the two rules that account for ~7,500 of oxlint's ~7,800 default
    // findings on this tree. Both are legacy-shaped, not bugs: decaffeinate left
    // unused locals everywhere, and CoffeeScript's implicit returns became
    // bare expression statements. eslint had them off too, via the per-directory
    // overrides. Turning them on is a cleanup project, not a gate.
    "no-unused-vars": "off",
    "no-unused-expressions": "off",

    // decaffeinate emits `\/` and similar in regexes it translated; harmless
    "no-useless-escape": "off",

    // `const self = this` is the shape the bluebird `.bind(this)` migration left
    // behind on purpose (see MODERNIZATION_PLAN.md stage 5d)
    "typescript/no-this-alias": "off",

    // --- correctness rules kept VISIBLE but not gating ----------------------
    //
    // Each of these is a legitimate rule whose current hits are all intentional
    // legacy shapes, verified one by one. They stay as warnings so a NEW one is
    // visible in output, without the whole gate going red for code that is
    // deliberately the way it is.
    //
    //   no-unreachable        after guards like `throw new Error('not tested')`
    //   no-unassigned-vars    feature blocks commented out on purpose, e.g.
    //                         "for now, don't show general sprites"
    //   erasing-op            `-winHeight * 0.0`, written for symmetry with the
    //                         sibling `* 0.1` lines around it
    //   no-extra-boolean-cast a redundant `!!`
    // --- unicorn stylistic rules, off ---------------------------------------
    //
    // `Promise.all([oneThing])` accounts for 129 of these and 87 of those are in
    // server/migrations, which is append-only history -- rewriting them is pure
    // churn against files that must never change. The other two are equally
    // cosmetic. None of this is what the linter is here for.
    "unicorn/no-single-promise-in-promise-methods": "off",
    "unicorn/no-new-array": "off",
    "unicorn/no-empty-file": "off",

    "no-unreachable": "warn",
    "no-unassigned-vars": "warn",
    "oxc/erasing-op": "warn",
    "no-extra-boolean-cast": "warn",
  },
}
