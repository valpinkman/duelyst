    "quotes": [
      "error",
      "single"
    ],
    "semi": [
      "error",
      "always"
    ],
    "vars-on-top": [
      "warn"
    ],
    "import/extensions": [
      "error"
    ],
    "import/no-extraneous-dependencies": [
      "warn"
    ],
    "import/no-unresolved": [
      "error",
