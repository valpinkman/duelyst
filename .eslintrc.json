{
  "env": {
    "browser": true,
    "commonjs": true,
    "es6": true,
    "jquery": true
  },
  "extends": [
    "airbnb-base",
    "plugin:import/errors",
    "plugin:import/warnings",
    "plugin:mocha/recommended"
  ],
  "plugins": [
    "import",
    "mocha"
  ],
  "settings": {
    "import/resolver": {
      "node": {
        "extensions": [
          ".coffee",
          ".js"
        ],
        "moduleDirectory": [
          "node_modules"
        ]
      }
    }
  },
  "globals": {
    "cc": "readonly",
    "gl": "readonly"
  },
  "rules": {
    "global-require": [
      "warn"
    ],
    "implicit-arrow-linebreak": [
      "warn"
    ],
    "indent": [
      "error",
      2
    ],
    "linebreak-style": "warn",
    "lines-between-class-members": [
      "error",
      "always",
      {
        "exceptAfterSingleLine": true
      }
    ],
    "max-len": [
      "warn"
    ],
    "new-cap": [
      "warn"
    ],
    "no-bitwise": [
      "warn"
    ],
    "no-continue": [
      "warn"
