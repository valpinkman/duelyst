{
  "//": [
    "WORKING config for the CoffeeScript -> JS -> TypeScript migration.",
    "Deliberately loose: files are renamed .js -> .ts in batches and typed",
    "incrementally. tsconfig.strict.json is the DESTINATION - run",
    "`pnpm tsc:strict` to see how far the codebase still is from it.",
    "Nothing is emitted from here: Vite/rolldown builds the client, tsx runs",
    "the server, vitest runs the tests. This config is for editors and",
    "`pnpm typecheck` only."
  ],
  "compilerOptions": {
    "target": "es2020",
    "module": "preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "noImplicitAny": false,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "app/*": ["./app/*"],
      "server/*": ["./server/*"],
      "worker/*": ["./worker/*"],
      "config/*": ["./config/*"],
      "test/*": ["./test/*"]
    }
  },
  "include": [
    "app/types/*.d.ts",
    "app/**/*.ts",
    "packages/sdk/**/*.ts",
    "packages/common/**/*.ts",
    "packages/data/**/*.ts",
    "server/**/*.ts",
    "worker/**/*.ts",
    "test/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "app/vendor",
    "app/resources",
    "app/original_resources",
    "packages/chroma-js",
    "packages/Backbone.VirtualCollection",
    "apps/desktop",
    "app/tools/FileSaver.min.ts",
    "app/tools/dat.gui.ts"
  ]
}
