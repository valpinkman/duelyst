# The root .dockerignore excludes everything the browser client is built FROM
# (apps/client/view, apps/client/ui, apps/client/vendor, apps/client/resources), because the server-only images
# do not need it. This image does. BuildKit reads <dockerfile>.dockerignore in
# preference to the root one, so the exclusions are restated here minus those.
.git
node_modules
dist
build
.pgdata
.env
# 587 MB of source art; the build reads apps/client/resources, never this
apps/client/original_resources
apps/desktop
docs
terraform
test
