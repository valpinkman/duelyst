  "scripts": {
    "api": "node ./bin/api",
    "game": "node ./bin/game",
    "sp": "node ./bin/single_player",
    "worker": "node ./bin/worker",
    "worker-ui": "node ./bin/workerui",
    "build": "node scripts/build/build-client.mjs",
    "lint:js": "eslint --quiet",
    "lint:js:all": "eslint --quiet --ext .js,.ts app config desktop scripts server test worker",
    "format:js": "eslint --quiet --fix",
    "format:js:all": "eslint --quiet --ext .js,.ts --fix app config desktop scripts server test worker",
    "migrate:latest": "cd ./server && knex migrate:latest",
    "migrate:rollback": "cd ./server && knex migrate:rollback",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mjs",
    "test:integration:achievements": "vitest run --config vitest.integration.config.mjs test/integration/achievements",
    "test:integration:data_access": "vitest run --config vitest.integration.config.mjs test/integration/data_access",
    "test:integration:firebase": "vitest run --config vitest.integration.config.mjs test/integration/firebase",
    "test:integration:misc": "vitest run --config vitest.integration.config.mjs test/integration/misc",
    "test:unit": "vitest run",
    "tsc:chroma-js": "tsc -p ./packages/chroma-js/tsconfig.json",
    "build:vite": "vite build --config vite.config.client.mjs",
    "build:client": "node scripts/build/build-client.mjs",
    "build:client:watch": "vite build --config vite.config.client.mjs --watch",
    "typecheck": "tsc -p tsconfig.json",
    "tsc:strict": "tsc -p tsconfig.strict.json",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:rules": "firebase emulators:exec --only database \"vitest run --config vitest.rules.config.mjs\""
  },
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt",
      "electron"
    ],
    "overrides": {
      "jsonwebtoken": "^9.0.3"
    }
  }
