{
  "name": "open-duelyst",
  "version": "1.97.16",
  "license": "CC0-1.0",
  "scripts": {
    "api": "node ./bin/api",
    "game": "node ./bin/game",
    "sp": "node ./bin/single_player",
    "worker": "node ./bin/worker",
    "worker-ui": "node ./bin/workerui",
    "build": "turbo run build:client",
    "migrate:latest": "cd ./apps/server && knex migrate:latest",
    "migrate:latest:built": "cd build/apps/server && knex migrate:latest",
    "migrate:rollback": "cd ./apps/server && knex migrate:rollback",
    "test": "turbo run test test:root",
    "test:integration": "vitest run --config vitest.integration.config.mjs",
    "test:integration:achievements": "vitest run --config vitest.integration.config.mjs test/integration/achievements",
    "test:integration:data_access": "vitest run --config vitest.integration.config.mjs test/integration/data_access",
    "test:integration:firebase": "vitest run --config vitest.integration.config.mjs test/integration/firebase",
    "test:integration:misc": "vitest run --config vitest.integration.config.mjs test/integration/misc",
    "test:integration:jobs": "vitest run --config vitest.integration.config.mjs test/integration/jobs",
    "test:unit": "turbo run test test:root",
    "build:vite": "vite build --config vite.config.client.mjs",
    "build:client": "node tools/build/build-client.mjs",
    "build:client:watch": "vite build --config vite.config.client.mjs --watch",
    "typecheck": "turbo run typecheck typecheck:root",
    "lint": "turbo run lint lint:root",
    "lint:fix": "turbo run lint:fix lint:fix:root",
    "format": "turbo run format format:root",
    "format:check": "turbo run format:check format:check:root",
    "tsc:strict": "tsc -p tsconfig.strict.json",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:rules": "firebase emulators:exec --only database \"vitest run --config vitest.rules.config.mjs\"",
    "check:promise-utils": "node tools/check-promise-utils-bindings.mjs",
    "check:bluebird-orphans": "node tools/check-no-bluebird-orphans.mjs",
    "check:package-deps": "node tools/check-package-deps.mjs",
    "check:undefined-names": "node tools/check-no-undefined-names.mjs",
    "typecheck:root": "tsc -p tsconfig.json",
    "lint:root": "oxlint",
    "format:root": "oxfmt .",
    "format:check:root": "oxfmt --check .",
    "test:root": "vitest run",
    "check:turbo-env": "node tools/check-turbo-env.mjs",
    "lint:fix:root": "oxlint --fix",
    "build:server": "turbo run build:server:root",
    "build:server:root": "node tools/build/build-server.mjs",
    "check:data-access": "node tools/check-data-access-baseline.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1114.0",
    "@bull-board/api": "^9.3.2",
    "@bull-board/express": "^9.3.2",
    "@counterplay/chromajs": "workspace:*",
    "@duelyst/client": "workspace:*",
    "@duelyst/common": "workspace:*",
    "@duelyst/config": "workspace:*",
    "@duelyst/data": "workspace:*",
    "@duelyst/sdk": "workspace:*",
    "@duelyst/server": "workspace:*",
    "@duelyst/worker": "workspace:*",
    "@firebase/app-types": "0.7.0",
    "@thream/socketio-jwt": "2.2.1",
    "backbone": "catalog:",
    "backbone-virtual-collection": "workspace:*",
    "backbone.marionette": "2.2.2",
    "bcrypt": "^5.0.1",
    "body-parser": "^1.6.5",
    "bootstrap-sass": "3.4.3",
    "bullmq": "^6.1.2",
    "change-case": "2.3.0",
    "colors": "*",
    "compose-middleware": "^2.0.1",
    "convict": "^6.2.2",
    "cors": "^2.7.1",
    "debug": "^2.2.0",
    "enum": "^2.3.0",
    "express": "^4.22.2",
    "express-jwt": "^8.5.1",
    "express-real-ip": "^1.0.0",
    "firebase": "12.18.0",
    "firebase-admin": "^14.3.0",
    "font-awesome": "4.7.0",
    "form-urlencoded": "^1.2.1",
    "glicko2": "^1.2.1",
    "hbs": "4.2.1",
    "helmet": "^8.3.0",
    "i18next": "^19.8.5",
    "i18next-browser-languagedetector": "^2.1.0",
    "i18next-xhr-backend": "^1.2.1",
    "ioredis": "^6.0.0",
    "isomorphic-fetch": "catalog:",
    "jquery": "2.1.4",
    "js-base64": "^2.1.5",
    "jsonwebtoken": "^9.0.3",
    "jwt-decode": "^2.0.1",
    "knex": "^3.3.0",
    "markdown": "0.5.0",
    "mkdirp": "^0.5.0",
    "moment": "^2.30.1",
    "moment-duration-format": "1.3.0",
    "morgan": "^1.2.3",
    "p-throttle": "^1.1.0",
    "p-whilst": "^1.0.0",
    "pg": "8.0.3",
    "pretty-ms": "^7.0.0",
    "prettyjson": "1.2.5",
    "query-string": "^4.3.4",
    "require-dir": "^0.3.2",
    "semver": "^5.0.1",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3",
    "store2": "^2.5.1",
    "superagent": "^3.5.2",
    "tcomb": "^2.6.0",
    "tcomb-validation": "^2.3.0",
    "ua-parser-js": "^0.7.3",
    "underscore": "catalog:",
    "uuid": "^13.0.2",
    "validator": "^13.15.35",
    "velocity-animate": "~1.2.0",
    "web-animations-js": "2.1.3",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "async": "^1.5.2",
    "autoprefixer": "^10.5.4",
    "benchmark": "^2.1.0",
    "chai": "^3.5.0",
    "clipboard": "^1.7.1",
    "decaffeinate": "^8.1.4",
    "esbuild": "0.28.2",
    "events": "^3.3.0",
    "fast-stats": "0.0.7",
    "firebase-tools": "^14.27.0",
    "glsl-fxaa": "^3.0.0",
    "glslify": "2.1.2",
    "glslify7": "npm:glslify@^7.1.1",
    "handlebars": "^4.7.9",
    "os-browserify": "^0.3.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.26",
    "sass": "^1.103.0",
    "string": "^3.3.3",
    "tsx": "^4.23.12",
    "turbo": "^2.10.11",
    "typescript": "catalog:",
    "url": "^0.11.4",
    "vite": "catalog:",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt",
      "electron"
    ],
    "overrides": {
      "jsonwebtoken": "^9.0.3",
      "backbone": "catalog:"
    }
  }
}
